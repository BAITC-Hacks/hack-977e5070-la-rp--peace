# Copy to .env and adjust. All values shown are the defaults.
DATABASE_URL=sqlite:///data/larp.sqlite3
MAX_UPLOAD_MB=20
# JSON list of origins allowed to call the API (SvelteKit dev server by default).
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO

# Profiling model (OpenAI). Parsing is unavailable until both are set.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional OpenAI-compatible endpoint
OPENAI_BASE_URL=
# Longer documents are sampled for the model; corrected answers requested on failed checks
PROFILE_MAX_CHARS=150000
PROFILE_RETRIES=2
PARSER_WORKERS=2
